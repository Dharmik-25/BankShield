# BankShield .gitignore

# Python Virtual Environment & Bytecode
backend/venv/
backend/env/
**/__pycache__/
*.py[cod]
*$py.class

# Node Dependencies & Build Output
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend_old/

# Temporary Test Databases (Isolated test artifacts)
test_*.db
backend/test_*.db

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.bak

# IMPORTANT: Ensure Academic Demonstration SQLite Database & Backups are NOT ignored
!backend/bankshield.db
!backend/bankshield_backup_*.db
